# spotdl works out of the box with its built-in (shared, rate-limited) Spotify
# credentials, so these are OPTIONAL. Add your own Spotify app credentials to
# avoid rate limits / for production use. Create an app at
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dropbox delivery. Create a DEDICATED app at https://www.dropbox.com/developers/apps
#   -> "Scoped access" -> "App folder" (sandboxed to /Apps/<AppName>/)
#   -> Permissions tab: enable files.content.write + files.content.read
# The App key / App secret are on the app's Settings tab. The refresh token is
# minted once by running: uv run python scripts/mint_dropbox_token.py
DROPBOX_ACCESS_KEY=
DROPBOX_ACCESS_SECRET=
DROPBOX_REFRESH_TOKEN=
# Base path INSIDE the app folder for the real crate (leading slash, no trailing).
# App-folder paths are relative to the app root, e.g. /music -> ~/Dropbox/Apps/<AppName>/music
DROPBOX_BASE_PATH=/music

# Where a download should land. Comma-separated; order is the upload order.
# dropbox = DJ/USB path (default, matches pre-R2 behavior)
# r2      = Cloudflare R2 (website/radio)
# both    = DELIVERY_DESTINATIONS=dropbox,r2
DELIVERY_DESTINATIONS=dropbox

# Cloudflare R2 (S3-compatible). Same env var names as the personal-site bucket
# so the same creds can be reused. Optional — only needed if r2 is in
# DELIVERY_DESTINATIONS or you run scripts/smoke_r2.py.
# Endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (region auto, sig v4).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Public base URL if you've attached a custom domain or enabled r2.dev on the
# bucket. Leave unset to keep objects private (no public URL is recorded).
# R2_PUBLIC_URL=
# Key prefix (default prod) and optional layout override.
# Default key: {prefix}/music/cratewire/{crate}/{artists} - {title}.{ext}
# R2_KEY_PREFIX=prod
# R2_KEY_LAYOUT={prefix}/music/cratewire/{crate}/{filename}
