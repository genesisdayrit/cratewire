# spotdl works out of the box with its built-in (shared, rate-limited) Spotify
# credentials, so these are OPTIONAL. Add your own Spotify app credentials to
# avoid rate limits / for production use. Create an app at
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Playlist for scripts/smoke_playlist.py. Kept out of the repo so the URL isn't
# hardcoded — set it here (or pass --playlist <url> on the command line).
SMOKE_PLAYLIST_URL=

# Dropbox delivery. Create a DEDICATED app at https://www.dropbox.com/developers/apps
#   -> "Scoped access" -> "App folder" (sandboxed to /Apps/<AppName>/)
#   -> Permissions tab: enable files.content.write + files.content.read
# The App key / App secret are on the app's Settings tab. The refresh token is
# minted once by running: uv run python scripts/mint_dropbox_token.py
DROPBOX_ACCESS_KEY=
DROPBOX_ACCESS_SECRET=
DROPBOX_REFRESH_TOKEN=
# Base path INSIDE the app folder for the real crate (leading slash, no trailing).
# App-folder paths are relative to the app root, e.g. /music -> ~/Dropbox/Apps/<AppName>/music
DROPBOX_BASE_PATH=/music
